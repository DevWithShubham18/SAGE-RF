# Select "openai" or "ollama".
LLM_PROVIDER=openai

# Firebase Admin authentication. A project ID supports ID-token verification.
# A service-account path is optional unless privileged Admin operations are used.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# OpenAI server-side configuration. Never expose this key to Vite/React.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Local Ollama configuration.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
